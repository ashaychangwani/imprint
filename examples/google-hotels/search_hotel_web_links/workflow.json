{
  "toolName": "search_hotel_web_links",
  "intent": {
    "description": "Search Google Hotels web links for a selected hotel name.",
    "userSaid": "searched for hotels at chicago loop from july 3-6; clicked one of hte offerings, saw booking options"
  },
  "site": "google-hotels",
  "parameters": [
    {
      "name": "hotel_name",
      "type": "string",
      "description": "Hotel name to search for.",
      "default": "Hyatt Regency Chicago",
      "verified": true
    },
    {
      "name": "limit",
      "type": "number",
      "description": "Maximum number of web link results to return.",
      "default": 3,
      "verified": true
    }
  ],
  "requests": [
    {
      "method": "POST",
      "url": "https://www.google.com/_/TravelFrontendUi/data/batchexecute?rpcids=bdmBfe&source-path=%2Ftravel%2Fsearch&f.sid=7513562915459271421&bl=boq_travel-frontend-ui_20260527.01_p0&hl=en-US&soc-app=162&soc-platform=1&soc-device=1&_reqid=3352256&rt=c",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
        "X-Same-Domain": "1",
        "Referer": "https://www.google.com/travel/search?q=${param.hotel_name}",
        "Accept-Language": "en-US,en;q=0.9",
        "x-goog-ext-190139975-jspb": "[\"US\",\"ZZ\",\"x6c25Q==\"]",
        "x-goog-ext-259736195-jspb": "[\"en-US\",\"US\",\"USD\",2,null,[420],null,null,7,[]]"
      },
      "body": "f.req=%5B%5B%5B%22bdmBfe%22%2C%22%5B%5C%22${param.hotel_name}%5C%22%2C${param.limit}%5D%22%2Cnull%2C%22generic%22%5D%5D%5D&",
      "effect": "safe"
    }
  ],
  "parserModule": "./parser.ts",
  "requestTransformModule": "./request-transform.ts",
  "liveVerified": true
}
