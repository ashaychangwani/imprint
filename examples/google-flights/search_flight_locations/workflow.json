{
  "toolName": "search_flight_locations",
  "intent": {
    "description": "Find ranked airports, cities, and other flight locations from a text query.",
    "userSaid": "Resolve typed flight origins and destinations such as SJC, San Diego, and Seattle."
  },
  "parameters": [
    {
      "name": "query",
      "type": "string",
      "description": "Airport code, airport name, city, region, or other location text to search.",
      "verified": true
    }
  ],
  "requests": [
    {
      "method": "POST",
      "url": "https://www.google.com/_/FlightsFrontendUi/data/batchexecute?rpcids=H028ib&source-path=%2Ftravel%2Fflights&f.sid=${state.f_sid}&bl=${state.bl}&hl=en-US&soc-app=162&soc-platform=1&soc-device=1&_reqid=${generated.epoch_ms}&rt=c",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
        "X-Same-Domain": "1",
        "Referer": "https://www.google.com/travel/flights",
        "Accept-Language": "en-US,en;q=0.9",
        "x-goog-ext-259736195-jspb": "[\"en-US\",\"US\",\"USD\",2,null,[420],null,null,7,[]]"
      },
      "body": "f.req=${param.query}",
      "effect": "safe"
    }
  ],
  "site": "google-flights",
  "bootstrap": {
    "url": "https://www.google.com/travel/flights",
    "waitUntil": "domcontentloaded",
    "captures": [
      {
        "source": "html_regex",
        "name": "f_sid",
        "pattern": "\"FdrFJe\":\"([^\"]+)\"",
        "group": 1,
        "required": true,
        "capability": "browser_bootstrap"
      },
      {
        "source": "html_regex",
        "name": "bl",
        "pattern": "\"cfb2h\":\"([^\"]+)\"",
        "group": 1,
        "required": true,
        "capability": "browser_bootstrap"
      }
    ]
  },
  "parserModule": "./parser.ts",
  "requestTransformModule": "./request-transform.ts",
  "liveVerified": true
}
