{
  "toolName": "validate_flight_itinerary",
  "intent": {
    "description": "Validate whether a Google Flights multi-leg itinerary is accepted as searchable by the BVAT3 endpoint.",
    "userSaid": "searched for a round trip flight; searched for a one way flight; did a multi city flight query; multi city from SJC to SAN to LAX to SFO; searched for a multi city flight; dropped the 3rd leg from teh fight"
  },
  "site": "google-flights",
  "parameters": [
    {
      "name": "itinerary",
      "type": "string",
      "description": "Ordered itinerary legs. Accepts JSON such as [{\"origin\":\"SJC\",\"destination\":\"SAN\"},{\"origin\":\"SAN\",\"destination\":\"SJC\"}] or compact text like SJC>SAN;SAN>SJC. Airport codes use type 0 and Google place ids like /m/0d9jr use type 5.",
      "default": "[{\"origin\":\"SJC\",\"destination\":\"SAN\"},{\"origin\":\"SAN\",\"destination\":\"SJC\"}]",
      "verified": true
    }
  ],
  "bootstrap": {
    "url": "https://www.google.com/travel/flights?tfs=CBwQARoSagcIARIDU0pDcgcIARIDU0FOGhJqBwgBEgNTQU5yBwgBEgNTSkNAAUgBcAGCAQsI____________AZgBAQ&tfu=KgIIAw",
    "waitUntil": "domcontentloaded",
    "waitMs": 500,
    "timeoutMs": 30000,
    "captures": [
      {
        "source": "html_regex",
        "name": "f_sid",
        "pattern": "\\\"FdrFJe\\\":\\\"([^\\\"]+)\\\"",
        "group": 1,
        "required": true,
        "capability": "browser_bootstrap"
      },
      {
        "source": "html_regex",
        "name": "bl",
        "pattern": "\\\"cfb2h\\\":\\\"([^\\\"]+)\\\"",
        "group": 1,
        "required": true,
        "capability": "browser_bootstrap"
      }
    ]
  },
  "requests": [
    {
      "method": "POST",
      "url": "https://www.google.com/_/FlightsFrontendUi/data/batchexecute?rpcids=BVAT3&source-path=%2Ftravel%2Fflights&f.sid=${state.f_sid}&bl=${state.bl}&hl=en-US&soc-app=162&soc-platform=1&soc-device=1&_reqid=${generated.epoch_ms}&rt=c",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
        "X-Same-Domain": "1",
        "Referer": "https://www.google.com/travel/flights",
        "Accept-Language": "en-US,en;q=0.9",
        "x-goog-ext-259736195-jspb": "[\"en-US\",\"US\",\"USD\",2,null,[420],null,null,7,[]]"
      },
      "body": "{\"itinerary\":\"${param.itinerary}\"}",
      "effect": "safe"
    }
  ],
  "parserModule": "./parser.ts",
  "requestTransformModule": "./request-transform.ts",
  "liveVerified": true
}
